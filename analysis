#!/bin/bash

# ANALYSIS SCRIPT
#
# This script analyzes a cleaned tab-seperated file containing board game data.
# It calculates the most popular game mechanics and domains, and the correlation between year and average rating, and complexity and average rating.
#
# It takes a single argument: the path to the cleaned tab-separated .TSV file.
# Usage: ./analysis <file>
#
# Authorship: Dipta Datta Gupta

# Check if the correct number of arguments is provided (file and separator)
if [[ $# -ne 1 ]]; then
    echo "Usage: <file>"  2> /dev/stderr
    exit 1
fi

# Check if the file exists and is not empty
if [ ! -s "$1" ]; then
    echo "Error: The specified input file $1 does not exist or is empty." 2> /dev/stderr
    exit 1
fi

# Check if the file is a regular file
if [ ! -f "$1" ]; then
    echo "Error: The specified input file $1 is not a regular file." 2> /dev/stderr
    exit 1
fi

# Check if the file is a tab-seperated file
# I used head to get the first line of the file
# I used grep to check if the first line of the file contains a tab character. The -q option is used to suppress the output of grep.
if ! head -1 "$1" | grep -q $'\t'; then
    echo "Error: The specified input file $1 is not a tab-seperated file." 2> /dev/stderr
    exit 1
fi
# Check if the Mechanics (13th column) and Domains (14th column) are present and not empty before proceeding
if ! awk -F'\t' 'NR > 1 {if ($13 == "" || $14 == "") exit 1}' "$1"; then
    echo "Error: The specified input file $1 does not contain valid game mechanics or domain values." 2> /dev/stderr
    exit 1
fi
# Check if the Year(3rd column), Average Rating (9th column), and Complexity (11th column) columns are present and not empty before proceeding
if ! awk -F'\t' 'NR > 1 {if ($3 == "" || $9 == "" || $11 == "") exit 1}' "$1"; then
    echo "Error: The specified input file $1 does not contain valid year, average rating, or complexity values." 2> /dev/stderr
    exit 1
fi

# MOST POPULAR GAME MECHANICS
# I used awk to extract the 13th column (Mechanics) from the input file
# I used the -F option to specify the tab character (\t) as the field separator
# I used tr to replace the commas with new lines so each game mechanic is on a new line
# I used awk to remove leading and trailing spaces by using the command {$1=$1; print} (Reference: https://stackoverflow.com/questions/9175801/how-to-remove-leading-and-trailing-whitespaces)
# I used grep to remove empty lines (Reference: https://stackoverflow.com/questions/3432555/remove-blank-lines-with-grep)
# Finally, I used awk again at the end again to pipe the second and 3rd outputs only
most_popular_game_mechanic=$(awk -F'\t' 'NR > 1 {print $13}' "$1" | tr ',' '\n' | awk '{$1=$1; print}' | grep -v '^$' | sort | uniq -c | sort -nr | head -n 1 | awk '{print $2,$3}')

# Get the count of the most popular game mechanic
# I used the same technique as above but I used awk to pipe the 1st output only at the end to get the count of the most popular game mechanic
most_popular_game_mechanic_count=$(awk -F'\t' 'NR > 1 {print $13}' "$1" | tr ',' '\n' | awk '{$1=$1; print}' | grep -v '^$' | sort | uniq -c | sort -nr | head -n 1 | awk '{print $1}')

# MOST POPULAR DOMAINS
# Same technique as most_popular_game_mechanics but I used the 14th column (Domains) instead
most_popular_domain=$(awk -F'\t' 'NR > 1 {print $14}' "$1" | tr ',' '\n' | awk '{$1=$1; print}' | grep -v '^$' | sort | uniq -c | sort -nr | head -n 1 | awk '{print $2,$3}')

# Get the count of the most popular domain
# I used the same technique as most_popular_game_mechanics_count but I used the 14th column (Domains) instead
most_popular_domain_count=$(awk -F'\t' 'NR > 1 {print $14}' "$1" | tr ',' '\n' | sed 's/^[ \t]*//;s/[ \t]*$//' | grep -v '^$' | sort | uniq -c | sort -nr | head -n 1 | awk '{print $1}')

# Print the results for the most popular game mechanics and domains
echo "The most popular game mechanic is $most_popular_game_mechanic found in $most_popular_game_mechanic_count games"
echo "The most popular domain is $most_popular_domain found in $most_popular_domain_count games"

# CORRELATION BETWEEN YEAR AND AVERAGE RATING
# I used awk to extract the 3rd column (Year) and the 9th column (Average Rating) from the input file
# I used this formula for correlation coefficient: r = (n*xy - x*y)/sqrt((n*xx - x*x)*(n*yy - y*y))
correlation_year_rating="$(awk -F'\t' 'NR>1 {x+=$3; y+=$9; xx+=$3*$3; yy+=$9*$9; xy+=$3*$9; n++}
END {
    printf "%.3f", (n*xy - x*y)/sqrt((n*xx - x*x)*(n*yy - y*y))
}' "$1")"

# CORRELATION BETWEEN COMPLEXITY AND AVERAGE RATING
# I used the same technique as "corelation_year_rating" but I used the 11th column (Complexity) instead of the 3rd column (Year)
correlation_complexity_rating="$(awk -F'\t' 'NR>1 {x+=$9; y+=$11; xx+=$9*$9; yy+=$11*$11; xy+=$9*$11; n++}
END {
    printf "%.3f", (n*xy - x*y)/sqrt((n*xx - x*x)*(n*yy - y*y))
}' "$1")"

# Print the correlation results
echo "The correlation between the year of publication and the average rating is $correlation_year_rating"
echo "The correlation between the complexity of a game and its average rating is $correlation_complexity_rating"