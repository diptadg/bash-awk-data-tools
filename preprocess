#!/bin/bash

# PREPROCESS SCRIPT

# This script processes a data file that has a semicolon ';' as the seperator to clean and transform the data.
# It replaces semicolons with tabs for separators 
# Converts floating-point numbers to use dots (.) instead of commas(,) for decimal places 
# Converts Microsoft line endings to Unix format
# Converts non-ASCII characters to ASCII.
# It also handles empty IDs by incrementing them and ensuring they are unique.
# The script outputs the cleaned data to standard output (stdout).

# It takes a single argument: the path to the data file.
# Usage: ./preprocess <file>
#
# Authorship: Dipta Datta Gupta


# Check if the correct number of arguments is provided (file)
if [ $# -ne 1 ]; then
    echo "Error: Expected 1 argument, but received $#." 2> /dev/null
    echo "Usage: $0 <file>" 2> /dev/stderr
    exit 1
fi
# Check if the file exists and is not empty
if [ ! -s "$1" ]; then
    echo "Error: The specified input file $1 does not exist or is empty." 2> /dev/stderr
    exit 1
fi
# Check if the file is a regular file
if [ ! -f "$1" ]; then
    echo "Error: The specified input file $1 is not a regular file." 2> /dev/stderr
    exit 1
fi

# Determine highest ID
new_id=$(awk -F ";" 'NR > 1 {print $1}' "$1" | sort -n | tail -n 1)


# Read the input file line by line
while IFS= read -r line; do
      # The line is split into two parts: id and other_lines
      IFS=";" read -r id other_lines <<< "$line" 
      # Check if the seperator is a semicolon before processing
      if [[ "$line" != *";"* ]]; then
      echo -e "Error: Failed to process input file $1. The input file contains separators that are not semicolon (;). Please run the script again with the correct semicolon-separated file.\n Note: This script only takes semicolon-seperated files" 2 > /dev/stderr
      exit 1
      fi
    # Check if the first field (ID) is empty
      if [ -z "$id" ]; then
        # Increment the ID
        ((new_id++))
        # Update the first field with the new ID
        id="$new_id"
      fi
  # Perform line transformations
  # The IFS variable is set to semicolon (IFS=";") to ensure that the columns are split correctly using semicolons
  IFS=";" read -r -a cols <<< "$other_lines"
  # Process each column in the cols array
  # I use "${!cols[@]}" to iterate over the indices of the cols array 
  # (Reference: https://stackoverflow.com/questions/6723426/looping-over-arrays-printing-both-index-and-value)
  for i in "${!cols[@]}"; do
    #Convert Microsoft line endings to Unix line endings and remove NON-ASCII characters
    # (Reference: https://stackoverflow.com/questions/3337936/remove-non-ascii-characters-from-a-file-in-place-in-unix-shell)
    # (Reference: https://stackoverflow.com/questions/16768776/convert-line-endings/16768848)
    cols[i]=$(echo "${cols[$i]}" | tr -d '\r' | tr -cd '\11\12\15\40-\176')
    # For all columns except Mechanics and Domains columns (index: 12 and 13), replace commas with dots
    # Here I use $((i+1)) to get the column number (1-based index)
    # I use the -ne operator to check if the column number is not equal to 12 or 13
    if [ $((i+1)) -ne 12 ] && [ $((i+1)) -ne 13 ]; then
      cols[i]=$(echo "${cols[$i]}" | tr ',' '.')
    fi
  done

# Output the id column and join the cols array separated by tabs in the final output.
# Effectively, this will replace the semicolons with a tab separator (Reference: https://stackoverflow.com/questions/57627024/using-ifs-with-echo)
  # The IFS variable is set to tab (IFS=$'\t') to ensure that the columns are joined with tabs
  # The "${cols[*]}" expands to all elements of the array, separated by the first character of IFS
  # The echo command is used to print the id and the transformed columns
  # The -e option enables interpretation of backslash escapes
  echo -e "${id}\t$(IFS=$'\t'; echo "${cols[*]}")"
done < "$1"