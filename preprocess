#!/bin/bash

# Check if the correct number of arguments is provided (file)
if [ $# -ne 1 ]; then
    echo "Usage: $0 <file>" 2> /dev/null
    exit 1
fi
# Check if the file exists and is not empty
if [ ! -s "$1" ]; then
    echo "Error: The specified input file $1 does not exist or is empty." 2> /dev/null
    exit 1
fi
# Check if the file is a regular file
if [ ! -f "$1" ]; then
    echo "Error: The specified input file $1 is not a regular file." 2> /dev/null
    exit 1
fi

# Determine highest ID
new_id=$(awk -F ";" 'NR > 1 {print $1}' "$1" | sort -n | tail -n 1)

# Read the input file line by line
while IFS= read -r line; do
      # Split the line into ID and the rest of the line
      IFS=";" read -r id other_lines <<< "$line"  
    # Check if the first field (ID) is empty
      if [ -z "$id" ]; then
        # Increment the ID
        ((new_id++))
        # Update the first field with the new ID
        id="$new_id"
      fi
  # Perform transformations on the line
  IFS=";" read -r -a cols <<< "$other_lines"
  # Process each column: Convert Microsoft line endings to Unix line endings and remove NON-ASCII characters
  # I use "${!cols[@]}" to iterate over the indices of the cols array
  for i in "${!cols[@]}"; do
    cols[i]=$(echo "${cols[$i]}" | tr ';' '\t' | tr -d '\r' | tr -cd '\11\12\15\40-\176')
    # For all columns except Mechanics and Domains columns (index: 12 and 13), replace commas with dots
    # Here I use $((i+1)) to get the column number (1-based index)
    # I use the -ne operator to check if the column number is not equal to 12 or 13
    if [ $((i+1)) -ne 12 ] && [ $((i+1)) -ne 13 ]; then
      cols[i]=$(echo "${cols[$i]}" | tr ',' '.')
    fi
  done

# Output the id column and join the cols array separated by tabs in the final output. Effectively, this will replace the semicolons with a tab separator
  # IFS=$'\t' is used to set the internal field separator to tab
  # The echo command is used to print the id and the transformed columns
  # The -e option enables interpretation of backslash escapes
  echo -e "${id}\t$(IFS=$'\t'; echo "${cols[*]}")"
done < "$1" > cleaned_file.tsv
echo "Processed file saved as cleaned_file.tsv"